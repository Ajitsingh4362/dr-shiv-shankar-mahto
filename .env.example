# ============================================================
# ENVIRONMENT VARIABLES — copy this to .env for local dev,
# and add each of these in Vercel: Project Settings -> Environment Variables
# ============================================================

# ---------- Existing (Supabase) — still used for Phase 2 tables (patients, appointments, billing) ----------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_ADMIN_PASSWORD=
VITE_ADMIN_PHONE=

# ---------- Neon Database (Phase 1: gallery, blog, faqs, testimonials, popup) ----------
# From Neon Console -> Dashboard -> Connect -> "Pooled connection"
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# ---------- Neon Auth (admin login) ----------
# From Neon Console -> Auth page -> Configuration tab -> "Auth Base URL"
# Same URL, but exposed to the frontend with the VITE_ prefix so the browser can use it too.
NEON_AUTH_URL=https://ep-xxx.neon.tech/neondb/auth
VITE_NEON_AUTH_URL=https://ep-xxx.neon.tech/neondb/auth

# ---------- Cloudflare R2 (image storage) ----------
# From Cloudflare Dashboard -> R2 -> Manage API Tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=mahto-clinic-images
# Public URL for reading images back. Either:
#  - R2 bucket's public dev URL (Settings -> Public Access -> "Allow Access"), or
#  - a custom domain you connect to the bucket
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev
